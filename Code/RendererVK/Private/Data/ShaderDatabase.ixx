export module RendererVK:ShaderDatabase;

import Core;
import :Aftermath;

//*********************************************************
// Implements a very simple shader database to help demonstrate
// how to use the Nsight Aftermath GPU crash dump decoder API.
//
// In a real world scenario this would be part of an offline
// analysis tool. This is for demonstration purposes only!
//
export class ShaderDatabase
{
public:
    ShaderDatabase();
    ~ShaderDatabase();

    // Initialize the shader database
    void Initialize(bool applicationUsesStrippedShaders);

    // Find a shader bytecode binary by shader hash. A REGISTERED variant (below) is read back from its cache file, and
    // its source name is logged and its SPIR-V written to Local/CrashShaders/<source>.<hash>.spv (the shaders in a crash
    // dump: open the dump in Nsight Graphics with that folder as a shader search path).
    bool FindShaderBinary(const GFSDK_Aftermath_ShaderBinaryHash& shaderHash, oc::vector<uint8_t>& shader) const;

    // EVERY shader variant the engine compiles or loads from the SPIR-V cache (Shader::GLSLtoSPV): its Aftermath hash ->
    // its cache file and its source file name. No SPIR-V kept in memory: a crash reads it back. Any thread; a no-op
    // without the Aftermath DLL.
    static void registerVariant(oc::span<const unsigned int> spirv, const oc::string& cachePath, const oc::string& debugFilePath);

    // Find a source shader debug info by shader debug name generated by the DXC compiler.
    bool FindShaderBinaryWithDebugData(const GFSDK_Aftermath_ShaderDebugName& shaderDebugName, oc::vector<uint8_t>& shader) const;

    void AddShaderBinaryWithDebugInfo(const char* strippedShaderFilePath, const char* shaderFilePath);

private:

    void AddShaderBinary(const char* shaderFilePath);

    static bool ReadFile(const char* filename, oc::vector<uint8_t>& data);

    // List of shader binaries by ShaderBinaryHash.
    oc::map<GFSDK_Aftermath_ShaderBinaryHash, oc::vector<uint8_t>> m_shaderBinaries;

    // List of available shader binaries with source debug information by ShaderDebugName.
    oc::map<GFSDK_Aftermath_ShaderDebugName, oc::vector<uint8_t>> m_shaderBinariesWithDebugInfo;
};