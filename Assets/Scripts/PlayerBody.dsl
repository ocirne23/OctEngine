SCRIPT_EXPORT void Update(const ScriptContext* ctx, Entity* self, float deltaSeconds, ScriptData* scriptData)
{
	if (deltaSeconds > 0.0f)
	{
		glm::vec3 pos = self->pos;
		if ((*scriptData).hasLast == 0)
		{
			(*scriptData).lastPos = pos;
			(*scriptData).hasLast = 1;
		}
		float vx = (pos.x - (*scriptData).lastPos.x) / deltaSeconds;
		float vz = (pos.z - (*scriptData).lastPos.z) / deltaSeconds;
		(*scriptData).lastPos = pos;
		float target = glm::sqrt((vx * vx) + (vz * vz));
		(*scriptData).speed += (target - (*scriptData).speed) * glm::min(1.0f, deltaSeconds * 10.0f);
		ctx->animatorSetFloat(scriptData->animator, ctx->internString("speed"), glm::min((*scriptData).speed / 8.0f, 2.0f));
		if ((*scriptData).speed > 0.5f)
		{
			float targetYaw = glm::degrees(glm::atan(vx, vz));
			(*scriptData).yawDeg = ocMoveTowardsAngle((*scriptData).yawDeg, targetYaw, 720.0f * deltaSeconds);
		}
		self->rot = glm::quat(glm::radians(glm::vec3(0.0f, (*scriptData).yawDeg, 0.0f)));
	}
}

REGISTER_UPDATE()

