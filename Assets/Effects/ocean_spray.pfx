# Ocean spray, spawned by the renderer's ocean spray producer (ocean_spray.cs.glsl) over the particle
# GPU spawn path: the producer sets position + velocity and PICKS THE EMITTER PER REQUEST by crest
# energy, so Rate/Speed/ConeAngle are unused here - only the look and the motion after spawn are
# authored. Rate 0 = no CPU spawns. EMITTER ORDER MATTERS: droplets, mist, foam chunks (the Particle
# system publishes the slots in this order).
ParticleEffect OceanSpray
	# Thrown water: small, fast, ballistic, streaked.
	Emitter Droplets
		Rate 0
		WaterFloor true
		# Hidden while the camera is under the sea (the flag's draw gate; no volume, so no relocation).
		AboveWater true
		Life 0.5 1.2
		Gravity 9.8
		Drag 0.5
		Turbulence 1.0 0.5 0
		Size 0.03 0.02
		SizeVariance 0.6
		VelocityStretch 0.02
		ColorStart 1.0, 1.0, 1.0, 0.7
		ColorEnd 0.9, 0.95, 1.0, 0
		Additivity 0.25
		FadeIn 0.05
		FadeOutStart 0.4
		SoftFade 0.3
		Lit true
		EmissiveFloor 0
	# Atomised mist off the crest: large, soft, slow, drifts and thins out.
	Emitter Mist
		Rate 0
		WaterFloor true
		AboveWater true
		Life 1.5 3.0
		Gravity 0.8
		Drag 1.2
		Turbulence 1.5 0.35 0.3
		Size 0.6 2.2
		SizeVariance 0.4
		ColorStart 0.9, 0.93, 1.0, 0.16
		ColorEnd 0.9, 0.93, 1.0, 0
		Additivity 0
		FadeIn 0.15
		FadeOutStart 0.3
		SoftFade 0.8
		Lit true
		EmissiveFloor 0
		Spin 0.6
	# Foam chunks torn off the lip: medium blobs, tumble, fall back onto the surface.
	Emitter Foam
		Rate 0
		WaterFloor true
		AboveWater true
		Life 0.6 1.4
		Gravity 7
		Drag 0.8
		Turbulence 0.6 0.6 0
		Size 0.04 0.03
		SizeVariance 0.5
		ColorStart 1.0, 1.0, 1.0, 0.9
		ColorEnd 1.0, 1.0, 1.0, 0
		Additivity 0
		FadeIn 0.05
		FadeOutStart 0.5
		SoftFade 0.25
		Lit true
		EmissiveFloor 0
		Spin 4
