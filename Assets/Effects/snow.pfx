# Snow: the rain volume with slow round flakes that wander in the turbulence field.
ParticleEffect Snow
	Emitter Flakes
		Volume 30, 15, 30
		Count 40000
		FollowCamera true
		Occlude true
		# Flakes follow the Particles/Wind tweaks almost at once.
		WindResponse 4.0
		Offset 0, -10, 0
		Direction 0, -1, 0
		ConeAngle 15
		Speed 1.5 2.5
		# Drag bounds the turbulence wander (lateral ~ turbulence / drag = 0.8 m/s) and gravity restores a
		# terminal fall of gravity / drag = 2 m/s; without drag the wander integrates without bound and
		# the flakes end up drifting at random.
		Gravity 3
		Drag 1.5
		Turbulence 1.2 0.3 0.2
		Size 0.06 0.06
		SizeVariance 0.5
		Spin 1.5
		ColorStart 1.0, 1.0, 1.0, 0.9
		ColorEnd 1.0, 1.0, 1.0, 0.9
		SoftFade 0.3
		Lit true
		EmissiveFloor 0.2
