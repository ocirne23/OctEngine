# Procedural clips: generated against the target skeleton, no source file. Bones = child entity names.
Animation cubeguy_idle
	Procedural            # no swings: holds the authored pose
		Duration 1.0

Animation cubeguy_walk
	Procedural Walk       # LeftLeg / RightLeg / LeftArm / RightArm
		Duration 0.8
		Axis 0 0 1
		LegAngle 35
		ArmAngle 30
	Event footstep 0.25
	Event footstep 0.75
