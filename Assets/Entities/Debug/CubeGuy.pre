	# The bare-minimum animator: four limbs, local Z only. The general one does the same walk as
	#   Component SceneAnimator: Layer Walk / Stride 6.0 / FullSpeed 4.0 / Fade 0.15 / Axis 0 0 1 / Walk { LegAngle 35, ArmAngle 30 }
	Component HumanoidAnimator
		Stride 6.0        # per full cycle (two steps), in MODEL units: x the entity scale = metres (0.25 -> 1.5 m)
		FullSpeed 4.0     # model units/s where the swing reaches full amplitude (0.25 -> 1 m/s)
		Fade 0.15
		LegAngle 35
		ArmAngle 30
