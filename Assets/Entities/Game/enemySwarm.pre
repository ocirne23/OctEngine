# SWARM unit: the cheap co-op horde body - health only. NO Component Force: no bubble, no shield
# battery, no GPU readbacks; friendly fields instead shove AND burn it through the BAKED pressure
# field (a CPU tap + gradient; the bubble-radius check is only the fallback when the bake is off)
# and it still strains emitters (EmitterDrain). Spawned in bulk
# by GameMatch's ambient scatter + wave director (spawnLooseUnit). ContactEvents feed projectile
# hit damage.
Prefab gameEnemySwarm
	CullMode RootOnly
	Component Scene
		Prefab CubeGuy        # the model - see enemyGrunt.pre
			Position 0 0.483 0
			Scale 0.196
	Component Physics
		Body Dynamic
		Shape Sphere
		Radius 0.35
		Density 100
		Friction 0
		LockRotation true
		ContactEvents true
	Component Network
	Component GameUnit
		ShortName SWRM
		Color 1 0.12 0.08
		Team 1
		HealthMax 15
		EnergyMax 0
		ShieldOutput 0
		MoveSpeed 4.5
		Accel 25
		AttackRange 1.2
		AttackInterval 1.0
		AttackDamage 5
		PlayerDamage 8
		EmitterDrain 1
