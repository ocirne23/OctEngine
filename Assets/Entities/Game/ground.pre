# Whitebox ground plane: 600x600 m, physics box top at entity y + 0.5 (the game spawns the root at
# y = -0.5 so the walkable surface sits at world y = 0; the render plane is offset up to match).
Prefab gameGround
	Component Scene
	Component Render
		ObjectContainer baseshapes
		Node Plane
		Type StaticMesh
		Position 0 0.5 0
		Scale 300
	Component Physics
		Body Static
		Shape Box
		HalfExtents 300 0.5 300
		Friction 0.6
