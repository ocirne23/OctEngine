# Battery: adds energy storage to its cabled grid ("Battery capacity" tweak). Its charge lives on
# the structure - destroying it loses the stored energy. A squat 2x1x2 m block (CubeHalf).
# Spawned origin 0.5 above ground.
Prefab gameBattery
	Component Render
		ObjectContainer baseshapes
		Node CubeHalf
		Type StaticMesh
		Color 1 0.7 0.1
		Scale 1
	Component Physics
		Body Static
		ContactEvents true
		Shape Box
		HalfExtents 1 0.5 1
	Component GameStructure
		MeleeRadius 1
